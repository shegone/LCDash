{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lcdash.local/schema/document-intake-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "package_root", "admission", "files"],
  "properties": {
    "schema_version": {"const": "lcdash.document-intake.v1"},
    "manifest_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,127}$"},
    "package_root": {"const": "work/document-intake-staging"},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "approval_id", "signed_by", "signed_at", "signature", "protected_data_present", "classification_decision"],
      "properties": {
        "decision": {"const": "approved"},
        "approval_id": {"type": "string"},
        "signed_by": {"type": "string"},
        "signed_at": {"type": "string", "format": "date-time"},
        "signature": {"type": "string"},
        "protected_data_present": {"const": false},
        "classification_decision": {"const": "no-protected-data-approved"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["staged_path", "destination_key", "bytes", "sha256", "category", "malware_scan", "secret_scan", "human_approved"],
        "properties": {
          "staged_path": {"type": "string"},
          "destination_key": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 26214400},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "category": {"type": "string"},
          "malware_scan": {"const": "passed"},
          "secret_scan": {"const": "passed"},
          "human_approved": {"const": true}
        }
      }
    }
  }
}
