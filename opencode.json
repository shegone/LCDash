{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.5:27b",
  "small_model": "ollama/qwen3.5:9b",
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LCDash Local Ollama",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "qwen3.5:27b": {
          "name": "Qwen 3.5 27B"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B"
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "grep": "allow",
    "glob": "allow",
    "task": "allow",
    "skill": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "docker *": "deny",
      "git push *": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": [".git/**", ".cptr/**", ".pytest_cache/**", "__pycache__/**"]
  }
}
