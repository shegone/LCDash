[Unit]
Description=Mindshare IRP multicast radio capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/opt/mindshare-radio-capture
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mindshare-radio-capture/.venv/bin/python /opt/mindshare-radio-capture/capture.py --config /opt/mindshare-radio-capture/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mindshare-radio-capture
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
