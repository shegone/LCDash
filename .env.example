# LCDash Environment Configuration
# Copy this file to .env on the server or development machine.
# Never commit the real .env file to GitHub.

# CentralSquare / ProSuite API
CENTRALSQUARE_TOKEN_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/token
CENTRALSQUARE_CAD_BASE_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/cad/v1
CENTRALSQUARE_SYSTEM_BASE_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/system/v1
CENTRALSQUARE_USERNAME=
CENTRALSQUARE_PASSWORD=
CENTRALSQUARE_FROM_HEADER=LCDash
# Production containers can use *_FILE values instead of plaintext environment values:
# CENTRALSQUARE_USERNAME_FILE=/run/secrets/centralsquare_username
# CENTRALSQUARE_PASSWORD_FILE=/run/secrets/centralsquare_password

# LCDash Web App
LCDASH_HOST=0.0.0.0
LCDASH_PORT=8000
LCDASH_DEBUG=true

# PostgreSQL Analytics
DATABASE_URL=postgresql://lcdash_user:change_me@localhost:5432/lcdash
# DATABASE_URL_FILE=/run/secrets/database_url

# Use a unique random secret for CentralSquare webhook HTTP Basic authentication.
CENTRALSQUARE_WEBHOOK_SECRET=
# CENTRALSQUARE_WEBHOOK_SECRET_FILE=/run/secrets/centralsquare_webhook_secret
WEBHOOK_MAX_BODY_BYTES=1048576
REALTIME_HEARTBEAT_SECONDS=15
ANALYTICS_INITIAL_LOOKBACK_HOURS=24
ANALYTICS_OVERLAP_MINUTES=120
ANALYTICS_MAX_CALLS_PER_RUN=250
ANALYTICS_REQUEST_DELAY_MS=100
ANALYTICS_SYNC_INTERVAL_SECONDS=300

# EMS delayed-call alerting
# LCDash resolves the on-duty recipient from these CAD units and ignores units
# whose current CAD status is Off Duty or Out of Service.
EMS_SUPERVISOR_UNIT_NUMBERS=EMS101,EMS102,EMS103,EMS104,EMS105,EMS106,EMS107,EMS108,EMS109
EMS_DELAY_ALERT_ENABLED=false
EMS_DELAY_ALERT_MODE=dry_run
EMS_DELAY_THRESHOLD_MINUTES=30
EMS_DELAY_REPEAT_MINUTES=30
EMS_DELAY_POLL_SECONDS=60
EMS_DELAY_TRANSFER_CODES=TRANSFER,911TRANS
EMS_RESPONSE_AGENCIES=LEASA
EMS_UNIT_PREFIXES=MED,EMS

# MAE - Mission Assistance Engine
# Production Docker uses http://ollama:11434. Windows development can use
# http://127.0.0.1:11434 when Ollama is installed locally.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MAE_MODEL=qwen3:8b
MAE_REQUEST_TIMEOUT_SECONDS=120
MAE_EMBEDDING_MODEL=nomic-embed-text
MAE_EMBEDDING_TIMEOUT_SECONDS=45

# MAE Knowledge Library
KNOWLEDGE_SOURCE_DIR=knowledge/centralsquare
KNOWLEDGE_INDEX_INTERVAL_SECONDS=3600
MINDSHARE_KNOWLEDGE_SOURCE_DIR=knowledge/mindshare
MINDSHARE_KNOWLEDGE_INDEX_INTERVAL_SECONDS=3600
MINDSHARE_KNOWLEDGE_RCLONE_REMOTE=lcdash-drive:Mindshare Documents
KNOWLEDGE_SEMANTIC_CANDIDATES=5000
# Server-side rclone path. The configured Google Drive account must be able
# to read this folder. The sync uses copy, not delete/sync.
KNOWLEDGE_RCLONE_REMOTE=lcdash-drive:Central Squared CAD/pdf
KNOWLEDGE_SYNC_INTERVAL_SECONDS=900
