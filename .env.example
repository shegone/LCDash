# LCDash Environment Configuration
# Copy this file to .env on the server or development machine.
# Never commit the real .env file to GitHub.

# CentralSquare / ProSuite API
CENTRALSQUARE_TOKEN_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/token
CENTRALSQUARE_CAD_BASE_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/cad/v1
CENTRALSQUARE_SYSTEM_BASE_URL=https://api-wv-logan-911.centralsquarecloudgov.com/api/system/v1
CENTRALSQUARE_USERNAME=
CENTRALSQUARE_PASSWORD=
CENTRALSQUARE_FROM_HEADER=LCDash
# Production containers can use *_FILE values instead of plaintext environment values:
# CENTRALSQUARE_USERNAME_FILE=/run/secrets/centralsquare_username
# CENTRALSQUARE_PASSWORD_FILE=/run/secrets/centralsquare_password

# LCDash Web App
LCDASH_HOST=0.0.0.0
LCDASH_PORT=8000
LCDASH_DEBUG=true

# PostgreSQL Analytics
DATABASE_URL=postgresql://lcdash_user:change_me@localhost:5432/lcdash
# DATABASE_URL_FILE=/run/secrets/database_url
ANALYTICS_INITIAL_LOOKBACK_HOURS=24
ANALYTICS_OVERLAP_MINUTES=120
ANALYTICS_MAX_CALLS_PER_RUN=250
ANALYTICS_REQUEST_DELAY_MS=100
ANALYTICS_SYNC_INTERVAL_SECONDS=300
